# ─── Python Runtime ──────────────────────────────────────────────────────────
# Byte-compiled / cached Python modules – regenerated on every run
__pycache__/
*.py[cod]
*.pyo

# Virtual environment – contains all pip-installed packages
venv/
.venv/
env/

# ─── Trained ML Models & Binary Artifacts ────────────────────────────────────
# These are large binary files (Keras .h5, TFLite .tflite) that belong
# in model storage/registries (e.g. HuggingFace Hub, S3), not Git
models/

# ─── Training Data ───────────────────────────────────────────────────────────
# CSVs and JSON stats generated by generate_dataset.py locally
# Can be very large and should be in proper data storage
dataset/training_data.csv
dataset/sample_stats.json

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
!.env.example

# ─── Database Files ──────────────────────────────────────────────────────────
# Local SQLite / data files written at runtime
db/*.db
db/*.sqlite
db/*.sqlite3

# Per-session frame buffers — accumulated at runtime, never seeded
db/frames/

# Generated training plans + reaction/broadcast logs — runtime state
db/plans.json
db/claps.json
db/broadcasts.json

# ─── Docker ──────────────────────────────────────────────────────────────────
# Docker volumes mounted locally, only relevant in production
.dockerenv

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
