# Personal Health Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8082
ENV=dev   # set to "prod" to enable HSTS and refuse wildcard CORS warnings

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list. Use "*" only in dev.
CORS_ORIGINS=*

# ── Auth ──────────────────────────────────────────────────────────────────
# CHANGE THIS in production. >=32 random bytes recommended.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL_MINUTES=1440

# ── Rate limiting (per IP, per route group) ───────────────────────────────
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# ── AI Coach (Anthropic) ──────────────────────────────────────────────────
# Leave blank to use deterministic fallback (always works in dev).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Database ──────────────────────────────────────────────────────────────
# Absolute path to the db/ directory. Defaults to ./db relative to api_server.py.
# On Railway use a persistent volume mount, e.g. /data/db
DB_PATH=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
